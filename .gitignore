# Netlify local state and build output
.netlify/

# Dependencies and local environment
.env
.env.*
!.env.example

# Track the function dependency manifests so Netlify installs them at deploy time.
# The actual node_modules are rebuilt on Netlify; do not commit local copies.
node_modules/
!netlify/functions/node_modules/.package-lock.json
!netlify/functions/package.json
!netlify/functions/package-lock.json

# Local sales/customer data (not site content)
prospects.json
outreach/
snapshots/

# Editor and backup artifacts
*.bak
*.bak-*
*.tmp
*~

# Legacy, unreferenced large media exports
/videos/
galetech-welcome-video.mp4
ai-security-audit-video.mp4
youtube-automation-video-v2.mp4
youtube-automation-video.mp4
youtube-automation-video.b64
narration.wav

# Keep the site videos used by current landing pages.
!assets/videos/*.mp4
